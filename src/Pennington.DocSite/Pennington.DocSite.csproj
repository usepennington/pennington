<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <LangVersion>preview</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <Description>Documentation site template for Pennington with layouts, pages, and content resolution</Description>
    <PackageTags>dotnet documentation-site static-site template</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <!-- Direct reference so the SharpYaml source generator runs in this project (DocSiteYamlContext). -->
    <PackageReference Include="SharpYaml" />
    <!-- Host-side WebAssembly render-mode wiring (AddInteractiveWebAssembly*), which is not part of
         the Microsoft.AspNetCore.App shared framework. Lets a consumer drop an interactive-WebAssembly
         island into a page by referencing a Blazor WebAssembly client project; costs nothing otherwise. -->
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" />
    <ProjectReference Include="..\Pennington\Pennington.csproj" />
    <ProjectReference Include="..\Pennington.UI\Pennington.UI.csproj" />
    <ProjectReference Include="..\Pennington.MonorailCss\Pennington.MonorailCss.csproj" />
  </ItemGroup>
</Project>
